# Puerto del servidor (por defecto 3000)
PORT=3000

# "production" desactiva CORS abierto y oculta detalles de errores
NODE_ENV=development

# Cadena de conexión de MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/dunklabs?retryWrites=true&w=majority

# Nombre de la base de datos
MONGODB_DB=dunklabs

# Clave para firmar la cookie de sesión. Usa una cadena larga y aleatoria.
SESSION_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Usuario que se crea con: npm run crear-admin
ADMIN_NOMBRE=Administrador Dunk Labs
ADMIN_EMAIL=admin@dunklabs.co
ADMIN_PASSWORD=define-una-contraseña-segura

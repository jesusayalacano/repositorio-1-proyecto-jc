{
  "name": "dunk-labs-server",
  "version": "1.0.0",
  "description": "Backend y servidor estático de dunk labs",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "crear-admin": "node scripts/crear-admin.js",
    "build:admin": "npm --prefix ../client install && npm --prefix ../client run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dunk-labs",
    "express",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
